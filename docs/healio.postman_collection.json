              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base}}/auth/login",
              "host": ["{{base}}"],
              "path": ["auth", "login"]
            }
          }
