                  "  pm.collectionVariables.set('admin_token', res.access_token);",
                  "  console.log('Admin token refreshed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
