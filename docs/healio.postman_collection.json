                  "  console.log('Doctor token saved, id:', res.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Sarah Smith\",\n  \"email\": \"doctor@test.com\",\n  \"password\": \"Password123\",\n  \"role\": \"doctor\",\n  \"phone\": \"0777654321\"\n}"
            },
            "url": {
              "raw": "{{base}}/auth/register",
              "host": ["{{base}}"],
              "path": ["auth", "register"]
