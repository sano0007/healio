# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string

# ─── MongoDB (Atlas or local) ─────────────────────────────────────────────────
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/<dbname>?appName=Cluster0
# Local:  mongodb://localhost:27017/<dbname>
MONGO_AUTH_URI=mongodb://localhost:27017/healio-auth
MONGO_PATIENT_URI=mongodb://localhost:27017/healio-patients
MONGO_DOCTOR_URI=mongodb://localhost:27017/healio-doctors
MONGO_APPOINTMENT_URI=mongodb://localhost:27017/healio-appointments
MONGO_PAYMENT_URI=mongodb://localhost:27017/healio-payments

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Stripe (sandbox) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-key-here

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@healio.app

# ─── Video (Jitsi — no API key needed) ───────────────────────────────────────
VIDEO_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si

# ─── Service Ports (TCP) ──────────────────────────────────────────────────────
AUTH_SERVICE_PORT=5001
PATIENT_SERVICE_PORT=5002
DOCTOR_SERVICE_PORT=5003
APPOINTMENT_SERVICE_PORT=5004
TELEMEDICINE_SERVICE_PORT=5005
PAYMENT_SERVICE_PORT=5006
NOTIFICATION_SERVICE_PORT=5007

# ─── Service Hosts ────────────────────────────────────────────────────────────
# Local dev: localhost
# Docker Compose / Kubernetes: use the service name (e.g. auth-service)
AUTH_SERVICE_HOST=localhost
PATIENT_SERVICE_HOST=localhost
DOCTOR_SERVICE_HOST=localhost
APPOINTMENT_SERVICE_HOST=localhost
TELEMEDICINE_SERVICE_HOST=localhost
PAYMENT_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_HOST=localhost