{
  "name": "healio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "kill-all-port": "kill $(lsof -t -i:3000,3001,9001,9002,9003,9004,9005,9006,9007,9008) || true",
    "dev": "bun run kill-all-port && turbo dev --concurrency=11",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "web:dev": "turbo dev --filter=web",
    "docker:up": "docker compose -f infra/docker-compose.yml --env-file .env up",
    "docker:up:build": "docker compose -f infra/docker-compose.yml --env-file .env up --build",
    "docker:up:fresh": "docker compose -f infra/docker-compose.yml --env-file .env build --no-cache && docker compose -f infra/docker-compose.yml --env-file .env up",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:down:volumes": "docker compose -f infra/docker-compose.yml down -v",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "k8s:build": "docker compose -f infra/docker-compose.yml --env-file .env build",
    "k8s:gen-secrets": "bash infra/scripts/gen-k8s-secrets.sh",
    "k8s:up": "kubectl apply -f infra/k8s/",
    "k8s:down": "kubectl delete namespace healio --ignore-not-found",
    "k8s:apply": "kubectl apply -f infra/k8s/",
    "k8s:delete": "kubectl delete -f infra/k8s/",
    "k8s:restart": "kubectl rollout restart deployment -n healio",
    "k8s:status": "kubectl get pods -n healio",
    "k8s:logs": "kubectl logs -n healio -l app",
    "k8s:mongodb": "kubectl port-forward -n healio svc/mongodb-service 27017:27017"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.3.3"
  },
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": ">=18"
  }
}
